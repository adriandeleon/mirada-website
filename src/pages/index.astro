---
import { href } from "../lib/site";
import { existsSync } from "node:fs";
import { resolve } from "node:path";
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";
import { groupedFeatures } from "../lib/features";
import { version, repo } from "../lib/mirada";
import { whatsNew, next, nextCount } from "../lib/whatsnew";
import { commandGroups } from "../lib/commands";
import { keysOf } from "../lib/keys";
import PaletteDemo from "../components/PaletteDemo.astro";
import PageToc from "../components/PageToc.astro";

const base = import.meta.env.BASE_URL;
const url = (p: string) => `${base}/${p}`.replace(/\/{2,}/g, "/");
const logo = url("mirada-icon.svg");

const allCommands = commandGroups.flatMap((g) => g.commands);
const commandCount = allCommands.length;

// Thumbnail for a feature card: public/screenshots/features/<slug>.<ext> when there is one,
// WebP first (scripts/gen-images.mjs makes one beside every PNG).
const shotExts = ["webp", "png", "jpg", "jpeg", "avif", "svg"];
const featureShot = (id: string) => {
  const p = shotExts
    .map((e) => `screenshots/features/${id}.${e}`)
    .find((fp) => existsSync(resolve("public", fp)));
  return p ? url(p) : null;
};

// The window screenshot: a JPEG of a photo is smaller than its PNG, and gen-images.mjs makes a
// WebP beside it as beside every screenshot.
const heroShot = existsSync(resolve("public", "screenshots/hero/window.jpg"));

// Latest entries for the home-page teaser, News and Blog interleaved by date. Same-day items
// tie-break on version (newest release first), then on the link.
const newsItems = (await getCollection("news")).map((e) => ({
  kind: "News",
  href: href(`/news/${e.id}`),
  title: e.data.title,
  description: e.data.description,
  date: e.data.date,
  version: e.data.version,
  beta: e.data.beta,
}));
const blogItems = (await getCollection("blog")).map((e) => ({
  kind: "Blog",
  href: href(`/blog/${e.id}`),
  title: e.data.title,
  description: e.data.description,
  date: e.data.date,
  version: undefined as string | undefined,
  beta: e.data.beta,
}));
const latest = [...newsItems, ...blogItems]
  .sort(
    (a, b) =>
      b.date.valueOf() - a.date.valueOf() ||
      (b.version ?? "").localeCompare(a.version ?? "", undefined, { numeric: true }) ||
      b.href.localeCompare(a.href),
  )
  .slice(0, 4);
const fmtDate = (d: Date) =>
  d.toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric", timeZone: "UTC" });

const featureGroups = await groupedFeatures();

// The keys a newcomer reaches for first, read from the generated command data.
const keyIds = [
  "next",
  "previous",
  "palette",
  "goToImage",
  "fit",
  "actualSize",
  "rotateClockwise",
  "edit",
  "info",
  "thumbnails",
  "fullScreen",
  "shortcuts",
];
const keyRows = keyIds.flatMap((id) => {
  const c = allCommands.find((x) => x.id === id);
  const k = c && keysOf(c);
  return k ? [{ title: c.title, ...k }] : [];
});

const platforms = [
  { name: "macOS", note: "DMG, Apple silicon and Intel" },
  { name: "Windows", note: "MSI installer (x64)" },
  { name: "Linux", note: "DEB, RPM or tar.gz, x64 and ARM64" },
];
---

<Layout>
  <PageToc />

  <section id="top" class="hero">
    <div class="hero-inner">
      <img class="hero-logo" src={logo} alt="Mirada logo" width="96" height="96" />
      <h2 class="hero-name">Mirada</h2>
      <h1 class="hero-title">Open a photo. The folder comes with it.</h1>
      <p class="tagline">
        A fast image viewer for macOS, Windows and Linux. The photo you opened is on
        screen in about an eighth of a second, and every other image in its folder is
        one arrow key away, in the order you'd number them. JPEG, PNG, WebP, HEIC,
        AVIF, JPEG&nbsp;XL, TIFF and PSD, turned upright and animated where the file
        is. No library, no import, no account.
      </p>
      <div class="cta">
        <a class="btn btn-primary" href="#download">Download</a>
        <a class="btn btn-ghost" href="#see-it">See the window</a>
      </div>

      <div class="badges">
        <a id="badge-stars" class="badge" href={`${repo}/stargazers`} hidden>
          <span class="badge-icon">★</span>
          <span id="badge-stars-count">—</span>
        </a>
        <a class="badge" href={`${repo}/blob/main/LICENSE`}>MIT License</a>
        <a id="badge-ci" class="badge" href={`${repo}/actions/workflows/ci.yml`} hidden>
          <span id="badge-ci-dot" class="badge-dot"></span>
          <span id="badge-ci-text">build</span>
        </a>
        <a class="badge" href={repo}>Open source on GitHub</a>
      </div>
    </div>

    <div class="hero-media">
      <PaletteDemo />
      <p class="hero-media-cap">
        The command palette over a photo, in the light or dark of the theme you
        pick above. Every command is in it, with its key and what it does.
      </p>
    </div>
  </section>

  <main>
    {
      heroShot && (
        <section id="see-it" class="section see-it">
          <h2>A look at the window</h2>
          <p class="section-lead">
            The real thing, laid out as GNOME's Image Viewer is: the photo fills the
            window, the title bar holds the menus and says which folder and which file, the properties
            sidebar says how large it is and what took it, and the thumbnail strip
            shows where it sits in the folder. Both panels are a key away, and closed
            until you want them.
          </p>
          <figure class="demo-poster">
            <picture>
              <source srcset={url("screenshots/hero/window.webp")} type="image/webp" />
              <img
                src={url("screenshots/hero/window.jpg")}
                alt="Mirada's window: the menus and the folder and file name in the title bar, a picture of green hills, a properties sidebar with the folder, position, size, format and dates, and a strip of thumbnails along the bottom"
                fetchpriority="high"
              />
            </picture>
            <figcaption>Mirada with the light theme, the menus in the title bar, the properties sidebar and the thumbnail strip.</figcaption>
          </figure>
        </section>
      )
    }

    <section id="why" class="section why">
      <h2>Why Mirada</h2>
      <p class="section-lead">
        An image viewer is the app you open a hundred times a day for three seconds
        each. Mirada is built for those three seconds.
      </p>
      <div class="pillars">
        <div class="pillar">
          <svg class="pillar-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M13 2 4 14h7l-1 8 9-12h-7l1-8Z" />
          </svg>
          <h3>Fast before anything else</h3>
          <p>
            A native executable, not a Java start-up: on Linux, about 125&nbsp;ms to a
            small JPEG and 170&nbsp;ms to a 24-megapixel one. The first image decodes while
            the window is still being built, and the images either side are ready
            before you press the arrow.
          </p>
        </div>
        <div class="pillar">
          <svg class="pillar-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2Z" />
          </svg>
          <h3>The folder is the document</h3>
          <p>
            Open one photo and the rest of the folder is there, <code>IMG_9</code>
            before <code>IMG_10</code>, or by date or size. Go to any image by typing
            part of its name; rename, trash or copy it without leaving the window.
            Nothing to import, and no catalogue to keep.
          </p>
        </div>
        <div class="pillar">
          <svg class="pillar-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="2" y="6" width="20" height="12" rx="2" />
            <path d="M6 10h.01M10 10h.01M14 10h.01M18 10h.01M8 14h8" />
          </svg>
          <h3>Every command, by key or by name</h3>
          <p>
            Arrows step, <kbd>+</kbd> and <kbd>-</kbd> zoom, <kbd>R</kbd> turns,
            <kbd>E</kbd> edits, and the command palette finds the rest as you type,
            with its key beside it. The same palette as Editora and Termina, and its
            keys are yours to choose.
          </p>
        </div>
      </div>

      <h3 class="why-sub">The codecs are built in, and built from source</h3>
      <p class="why-sub-lead">
        Behind the window are the reference decoders, called directly:
        <a href="https://libjpeg-turbo.org">libjpeg-turbo</a> for JPEG,
        <a href="https://chromium.googlesource.com/webm/libwebp">libwebp</a> for WebP,
        <a href="https://github.com/strukturag/libheif">libheif</a> with libde265 and
        dav1d for HEIC and AVIF, and <a href="https://github.com/libjxl/libjxl">libjxl</a>
        for JPEG&nbsp;XL, on every core. They are compiled from pinned sources for each
        platform and bundled, 3 to 4&nbsp;MB, so there is nothing to install and every
        machine decodes with the same versions. TIFF and PSD are read in pure Java.
        <a href={href("/docs/formats")}>What opens, and how</a>.
      </p>

      <p class="why-cta">
        <a class="btn btn-primary" href="#download">Download Mirada</a>
        <span>Free and open source, for macOS, Windows and Linux.</span>
      </p>
    </section>

    {
      latest.length > 0 && (
        <section id="latest" class="section">
          <div class="latest-head">
            <h2>From the blog &amp; news</h2>
            <span class="latest-links">
              <a href={href("/news")}>All news</a> · <a href={href("/blog")}>All posts</a>
            </span>
          </div>
          <div class="latest-grid">
            {latest.map((p) => (
              <a class="latest-card" href={p.href}>
                <span class="latest-tags">
                  <span class={`latest-kind kind-${p.kind.toLowerCase()}`}>{p.kind}</span>
                  {p.beta && <span class="beta-pill">Beta</span>}
                </span>
                <span class="latest-title">{p.title}</span>
                {p.description && <span class="latest-desc">{p.description}</span>}
                <span class="latest-date">{fmtDate(p.date)}</span>
              </a>
            ))}
          </div>
        </section>
      )
    }

    {
      whatsNew.length > 0 && (
        <section id="whats-new" class="section">
          <h2>What's new</h2>
          <p class="section-lead">
            The highlights of {version} and the releases just before it, from the changelog. See{" "}
            <a href={url("whats-new")}>What's new</a> for every release in full.
          </p>
          <ul class="news">
            {whatsNew.map((n) => (
              <li>
                <span class="news-title" set:html={n.title} />
                {n.detail && (
                  <span class="news-detail">
                    {": "}
                    <span set:html={n.detail} />
                  </span>
                )}
              </li>
            ))}
          </ul>
          {next.length > 0 && (
            <>
              <h3 class="next-title">In development</h3>
              <p class="next-lead">
                Working in the repository and headed for the next release, but not in {version}:
              </p>
              <ul class="news next">
                {next.map((n) => (
                  <li>
                    <span class="news-title" set:html={n.title} />
                    {n.detail && (
                      <span class="news-detail">
                        {": "}
                        <span set:html={n.detail} />
                      </span>
                    )}
                  </li>
                ))}
              </ul>
              {nextCount > next.length && (
                <p class="next-lead">
                  And {nextCount - next.length} more: <a href={url("whats-new#in-development")}>In development</a>.
                </p>
              )}
            </>
          )}
        </section>
      )
    }

    <section id="features" class="section">
      <h2>Features</h2>
      {
        featureGroups.map((g) => (
          <div class="feature-group">
            <h3 class="feature-group-title">{g.title}</h3>
            <div class="grid">
              {g.items.map((f) => {
                const shot = featureShot(f.id);
                return (
                  <a class="card" href={href(`/features/${f.id}`)}>
                    {shot ? (
                      <span class="card-shot">
                        <img src={shot} alt="" loading="lazy" decoding="async" width="560" height="315" />
                      </span>
                    ) : (
                      <span class="card-shot card-shot-empty" aria-hidden="true">
                        <svg viewBox="0 0 512 512" fill="none">
                          <path d="M110 256 Q256 120 402 256 Q256 392 110 256 Z" stroke="currentColor" stroke-width="34" stroke-linecap="round" stroke-linejoin="round" />
                          <circle cx="256" cy="256" r="58" fill="currentColor" />
                        </svg>
                      </span>
                    )}
                    <h4>
                      {f.data.title}
                      {f.data.beta && <span class="beta-pill">Beta</span>}
                    </h4>
                    <p set:html={f.data.summary} />
                  </a>
                );
              })}
            </div>
          </div>
        ))
      }
    </section>

    <section id="keys" class="section">
      <h2>Look without reaching for the mouse</h2>
      <p class="section-lead">
        There is no text to type into, so most keys are bare letters. Each is declared
        once, on the command, so the palette, the menus and the shortcut window can
        never disagree. A few to start with:
      </p>
      <ul class="keys">
        {
          keyRows.map((k) => (
            <li>
              <span>{k.title}</span>
              <kbd data-mac={k.mac}>{k.pc}</kbd>
            </li>
          ))
        }
      </ul>
      <p class="keys-more"><a href={href("/keybindings")}>All {commandCount} commands and their keys &rarr;</a></p>
    </section>

    <section id="download" class="section">
      <h2>Download</h2>
      <p class="section-lead">
        Installers for macOS, Windows and Linux are attached to each release. Each
        carries everything Mirada needs, codecs included, and registers it for the
        image types it opens.
      </p>
      <div class="platforms">
        {
          platforms.map((p) => (
            <div class="platform">
              <strong>{p.name}</strong>
              <span>{p.note}</span>
            </div>
          ))
        }
      </div>
      <div class="cta">
        <span class="dl-split">
          <a id="dl-primary" class="btn btn-primary dl-main" href={`${repo}/releases/latest`} data-repo={repo}>
            Download
          </a>
          <button
            id="dl-toggle"
            class="btn btn-primary dl-caret"
            type="button"
            aria-haspopup="true"
            aria-expanded="false"
            aria-label="Show downloads for all platforms"
            hidden
          >
            <span aria-hidden="true">▾</span>
          </button>
          <div id="dl-menu" class="dl-menu" role="menu" hidden></div>
        </span>
        <a class="btn btn-ghost" href={`${repo}/releases`}>All releases</a>
      </div>
      <p id="dl-sub" class="note">
        On Linux, install with <code>sudo apt install ./Mirada-*.deb</code> or
        <code>sudo dnf install ./Mirada-*.rpm</code>; the <code>.tar.gz</code> runs
        from wherever it is unpacked, as <code>bin/Mirada</code>.
      </p>
      <p class="note">
        The macOS and Windows installers are not signed yet. On macOS the first
        launch is blocked: open <em>System Settings → Privacy &amp; Security</em> and
        click <em>Open Anyway</em>. On Windows, if SmartScreen appears, choose
        <em>More info → Run anyway</em>. Each release lists SHA-256 checksums, signed
        with the key published beside them, and the Linux packages are signed too.
      </p>
    </section>

    <section id="quickstart" class="section">
      <h2>Build &amp; run from source</h2>
      <p class="section-lead">
        Requires JDK&nbsp;25. A Maven wrapper is bundled, so no local Maven install
        is needed, and the build downloads the codec bundle for your platform.
      </p>
      <div class="code-window">
        <div class="code-chrome">
          <span class="dot"></span><span class="dot"></span><span class="dot"></span>
          <span class="code-title">shell</span>
        </div>
        <pre><code><span class="tok-comment"># Clone</span>
<span class="tok-keyword">git</span> clone {repo}.git
<span class="tok-keyword">cd</span> Mirada

<span class="tok-comment"># Run the app, on a photo and its folder</span>
./mvnw javafx:run <span class="tok-flag">-Djavafx.args=</span>/path/to/photo.jpg

<span class="tok-comment"># Tests, null checks and formatting</span>
./mvnw verify

<span class="tok-comment"># The JVM app image in target/dist, on any JDK 25 (clean is required)</span>
./mvnw clean <span class="tok-flag">-Pdist</span> <span class="tok-flag">-DskipTests</span> package

<span class="tok-comment"># The native app, as it ships (Oracle GraalVM 25.4)</span>
./mvnw clean <span class="tok-flag">-Pdist,native</span> <span class="tok-flag">-DskipTests</span> package</code></pre>
      </div>
      <p class="note built-note">
        Built in the open with the help of AI coding tools. Every change lands as a
        reviewed, tested commit on GitHub.
      </p>
    </section>
  </main>

  <script is:inline define:vars={{ repo }}>
    (function () {
      var api = repo.replace("https://github.com/", "https://api.github.com/repos/");

      // --- OS-detected download ---
      (function () {
        var btn = document.getElementById("dl-primary");
        if (!btn) return;
        var ua = navigator.userAgent;
        var plat = navigator.platform || "";
        var os = "Linux",
          exts = [".deb", ".rpm"];
        if (/Mac/i.test(ua)) {
          os = "macOS";
          exts = [".dmg"];
        } else if (/Win/i.test(ua)) {
          os = "Windows";
          exts = [".msi"];
        } else if (/Fedora|Red Hat|SUSE|CentOS/i.test(ua)) {
          // A distribution that says so in its browser's user agent gets the RPM first.
          exts = [".rpm", ".deb"];
        }
        btn.textContent = "Download for " + os;

        // Detect CPU arch. Browsers report "MacIntel"/"Intel" even on Apple
        // Silicon, so beyond the UA/platform string (which catches Linux/Windows
        // ARM) use userAgentData.architecture (Chromium) and a WebGL "Apple GPU"
        // renderer heuristic (works in Safari) to catch M-series Macs.
        function webglIsApple() {
          try {
            var c = document.createElement("canvas");
            var gl = c.getContext("webgl") || c.getContext("experimental-webgl");
            if (!gl) return false;
            var dbg = gl.getExtension("WEBGL_debug_renderer_info");
            var r = dbg ? String(gl.getParameter(dbg.UNMASKED_RENDERER_WEBGL)) : "";
            return /apple/i.test(r) && !/intel|amd|radeon|nvidia/i.test(r);
          } catch (e) {
            return false;
          }
        }
        function detectArm(cb) {
          if (/aarch64|arm64|armv8|\barm\b/i.test(ua + " " + plat)) return cb(true);
          if (os === "Windows") return cb(false);
          var uad = navigator.userAgentData;
          if (uad && uad.getHighEntropyValues) {
            uad
              .getHighEntropyValues(["architecture"])
              .then(function (v) {
                cb(/arm|aarch/i.test(v.architecture || "") || webglIsApple());
              })
              .catch(function () {
                cb(webglIsApple());
              });
            return;
          }
          cb(webglIsApple());
        }

        detectArm(function (isArm) {
          // Never hand a visitor a package built for the other CPU. The one
          // cross-arch fallback is ARM Windows to x64, which runs under
          // emulation; there is no Windows ARM build, while macOS and Linux have
          // both. With no match the button keeps its link to the releases page.
          var archPrefs = isArm ? (os === "Windows" ? ["arm64", "x64"] : ["arm64"]) : ["x64"];
          // Try to deep-link the matching asset from the latest release.
          fetch(api + "/releases/latest")
            .then(function (r) {
              return r.ok ? r.json() : null;
            })
            .then(function (rel) {
              if (!rel || !rel.assets) return;
              var pick = null;
              // Arch first, then the OS's package types in order of preference
              // (asset names end with e.g. "-linux-x64.deb").
              for (var a = 0; a < archPrefs.length && !pick; a++) {
                for (var e = 0; e < exts.length && !pick; e++) {
                  for (var i = 0; i < rel.assets.length; i++) {
                    if (rel.assets[i].name.toLowerCase().endsWith("-" + archPrefs[a] + exts[e])) {
                      pick = rel.assets[i];
                      break;
                    }
                  }
                }
              }
              if (pick) {
                btn.href = pick.browser_download_url;
                if (rel.tag_name) btn.textContent = "Download for " + os + " (" + rel.tag_name + ")";
              }
              buildMenu(rel);
            })
            .catch(function () {});
        });

        // --- Every build, one click away ---
        // Asset names look like "Mirada-0.3.0-macos-arm64.dmg"; anything that
        // doesn't (SHA256SUMS, the .asc signatures) is skipped.
        function assetInfo(name) {
          if (/\.asc$/i.test(name)) return null;
          var m = name.match(/-(macos|windows|linux)-(arm64|aarch64|x64|x86_64)\.(.+)$/i);
          if (!m) return null;
          var p = m[1].toLowerCase();
          var arm = /arm|aarch/i.test(m[2]);
          var label =
            p === "macos"
              ? arm
                ? "macOS (Apple Silicon)"
                : "macOS (Intel)"
              : p === "windows"
                ? arm
                  ? "Windows (ARM64)"
                  : "Windows (x64)"
                : arm
                  ? "Linux (ARM64)"
                  : "Linux (x64)";
          return {
            plat: p,
            arm: arm,
            ext: m[3],
            label: label,
            meta: "." + m[3] + " · " + (arm ? "aarch64" : "x86_64"),
          };
        }

        function rank(map, key, dflt) {
          var v = map[String(key).toLowerCase()];
          return v === undefined ? dflt : v;
        }

        function buildMenu(rel) {
          var menu = document.getElementById("dl-menu");
          var toggle = document.getElementById("dl-toggle");
          if (!menu || !toggle || !rel || !rel.assets) return;

          var items = [];
          for (var i = 0; i < rel.assets.length; i++) {
            var info = assetInfo(rel.assets[i].name);
            if (!info) continue;
            info.url = rel.assets[i].browser_download_url;
            items.push(info);
          }
          if (!items.length) return;

          // macOS, Windows, Linux; DEB before RPM.
          var platRank = { macos: 0, windows: 1, linux: 2 };
          var extRank = { dmg: 0, msi: 0, exe: 0, deb: 1, rpm: 2, appimage: 3, "tar.gz": 4, zip: 5 };
          items.sort(function (a, b) {
            return (
              rank(platRank, a.plat, 9) - rank(platRank, b.plat, 9) ||
              // Apple Silicon first on macOS, x86 first elsewhere.
              (a.plat === "macos" ? (b.arm ? 1 : 0) - (a.arm ? 1 : 0) : (a.arm ? 1 : 0) - (b.arm ? 1 : 0)) ||
              rank(extRank, a.ext, 9) - rank(extRank, b.ext, 9) ||
              a.ext.localeCompare(b.ext)
            );
          });

          menu.textContent = "";
          items.forEach(function (it) {
            var a = document.createElement("a");
            a.className = "dl-item";
            a.href = it.url;
            a.setAttribute("role", "menuitem");
            var main = document.createElement("span");
            main.className = "dl-item-main";
            var name = document.createElement("span");
            name.className = "dl-item-name";
            name.textContent = it.label;
            var meta = document.createElement("span");
            meta.className = "dl-item-meta";
            meta.textContent = it.meta;
            main.appendChild(name);
            main.appendChild(meta);
            var arrow = document.createElement("span");
            arrow.className = "dl-item-arrow";
            arrow.setAttribute("aria-hidden", "true");
            arrow.textContent = "→";
            a.appendChild(main);
            a.appendChild(arrow);
            a.addEventListener("click", close);
            menu.appendChild(a);
          });
          toggle.hidden = false;

          function close() {
            menu.hidden = true;
            toggle.setAttribute("aria-expanded", "false");
          }
          toggle.addEventListener("click", function (e) {
            e.stopPropagation();
            if (menu.hidden) {
              menu.hidden = false;
              toggle.setAttribute("aria-expanded", "true");
            } else {
              close();
            }
          });
          document.addEventListener("click", function (e) {
            if (!menu.hidden && !menu.contains(e.target) && !toggle.contains(e.target)) close();
          });
          document.addEventListener("keydown", function (e) {
            if (e.key === "Escape" && !menu.hidden) {
              close();
              toggle.focus();
            }
          });
        }
      })();

      // --- GitHub stars ---
      fetch(api)
        .then(function (r) {
          return r.ok ? r.json() : null;
        })
        .then(function (d) {
          if (!d || typeof d.stargazers_count !== "number") return;
          // Only surface the star count once it reads as social proof rather
          // than a liability; below the threshold the "Open source on GitHub"
          // badge already invites a star.
          if (d.stargazers_count < 25) return;
          var el = document.getElementById("badge-stars");
          document.getElementById("badge-stars-count").textContent =
            d.stargazers_count.toLocaleString();
          el.hidden = false;
        })
        .catch(function () {});

      // --- CI status (latest run on default branch) ---
      fetch(api + "/actions/workflows/ci.yml/runs?branch=main&per_page=1")
        .then(function (r) {
          return r.ok ? r.json() : null;
        })
        .then(function (d) {
          if (!d || !d.workflow_runs || !d.workflow_runs.length) return;
          var run = d.workflow_runs[0];
          var ok = run.conclusion === "success";
          var el = document.getElementById("badge-ci");
          document.getElementById("badge-ci-text").textContent = ok
            ? "build passing"
            : "build " + (run.conclusion || run.status || "unknown");
          document.getElementById("badge-ci-dot").style.background = ok
            ? "#3fb950"
            : "#d29922";
          el.hidden = false;
        })
        .catch(function () {});
    })();
  </script>
</Layout>

