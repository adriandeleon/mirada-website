---
import { href } from "../lib/site";
import Layout from "../layouts/Layout.astro";
import { commandGroups } from "../lib/commands";
import { keysOf } from "../lib/keys";
import { version } from "../lib/mirada";

// Every command, grouped as the app's Keyboard Shortcuts window groups them, with its keys on each
// platform and the line the palette shows for it. Generated from the app's Command enum at the
// release tag (scripts/GenCommands.java), so it cannot drift from what the keys do.
const groups = commandGroups.map((g) => ({
  title: g.title,
  commands: g.commands.map((c) => ({ title: c.title, id: c.id, description: c.description, keys: keysOf(c) })),
}));
const total = groups.reduce((n, g) => n + g.commands.length, 0);
const bound = groups.reduce((n, g) => n + g.commands.filter((c) => c.keys).length, 0);
---

<Layout
  title="Keybindings — Mirada"
  description="Every Mirada command with its keys on Linux, Windows and macOS: stepping through the folder, zoom and pan, rotate and edit, the panels, the command palette and settings."
  ogImage="og/keybindings.png"
>
  <main class="page" data-pagefind-body data-pagefind-meta="kind:Reference">
    <h1>Keybindings</h1>
    <p class="lead">
      All {total} of Mirada {version}'s commands, {bound} of them with a key.
      All but Escape and the four pans are in the <strong>command palette</strong>
      too (<kbd data-mac="⇧⌘P">Ctrl+Shift+P</kbd>, <kbd data-mac="⌥X">Alt+X</kbd> or
      <kbd>F1</kbd>), which shows the line under each name here, and
      <strong>Keyboard Shortcuts</strong> (<kbd data-mac="⌘?">Ctrl+?</kbd>) lists
      them inside the app.
    </p>

    <div class="legend">
      <span>This page shows the Linux and Windows keys, and the Mac keys on a Mac</span>
      <span>Bare letters, as there is no text to type into; <kbd data-mac="⌘">Ctrl</kbd> for the file and window commands</span>
    </div>

    <div class="columns">
      {
        groups.map((g) => (
          <section class="group">
            <h2>{g.title}</h2>
            <table>
              <tbody>
                {g.commands.map((c) => (
                  <tr id={c.id}>
                    <td class="title">
                      {c.title}
                      <span class="desc">{c.description}</span>
                    </td>
                    <td class="keys">
                      {c.keys ? <kbd data-mac={c.keys.mac}>{c.keys.pc}</kbd> : <span class="none">palette</span>}
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </section>
        ))
      }
    </div>

    <p class="note">
      Each command has a second way in, too. <kbd>Space</kbd> and
      <kbd>Page Down</kbd> show the next image; <kbd>Shift+Space</kbd>,
      <kbd>Page Up</kbd> and <kbd>Backspace</kbd> the previous. <kbd>F11</kbd> is full
      screen as well as <kbd>F</kbd>, and <kbd data-mac="⌘R">Ctrl+R</kbd> and
      <kbd data-mac="⇧⌘R">Ctrl+Shift+R</kbd> rotate on every platform. On a Mac,
      Preview's keys work besides Mirada's: <kbd>⌘L</kbd> turns left, <kbd>⌘I</kbd>
      shows the properties and <kbd>⌃⌘F</kbd> is full screen. With the image zoomed,
      the wheel zooms about the pointer and dragging pans. In the editor every step
      has a key of its own, and <kbd data-mac="⌘Z">Ctrl+Z</kbd> undoes any of them. See <a href={href("/docs/keyboard")}>the keyboard guide</a>
      for the palette's own keys and how to change the ones that open it.
    </p>
  </main>
</Layout>

<style>
  .page {
    max-width: var(--maxw);
    margin: 0 auto;
    padding: 3rem 1.25rem 2rem;
  }
  h1 {
    font-size: 2.4rem;
    margin: 0 0 0.5rem;
    letter-spacing: -0.02em;
  }
  .lead {
    color: var(--muted);
    font-size: 1.05rem;
    margin: 0 0 1.5rem;
    max-width: 48rem;
  }
  .lead strong {
    color: var(--text);
  }
  .legend {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    color: var(--faint);
    font-size: 0.85rem;
    margin: 0 0 2rem;
  }
  .columns {
    columns: 2 26rem;
    column-gap: 2.5rem;
  }
  .group {
    break-inside: avoid;
    margin: 0 0 2rem;
  }
  .group h2 {
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--faint);
    margin: 0 0 0.4rem;
    padding-bottom: 0.4rem;
    border-bottom: 1px solid var(--border);
  }
  table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.93rem;
  }
  td {
    padding: 0.42rem 0;
    border-bottom: 1px solid var(--border-soft);
    vertical-align: top;
  }
  tr:target td {
    background: var(--accent-soft);
  }
  .title {
    color: var(--text);
    padding-right: 1rem;
  }
  .keys {
    text-align: right;
    white-space: nowrap;
  }
  .desc {
    display: block;
    color: var(--faint);
    font-size: 0.8rem;
    line-height: 1.4;
    margin-top: 0.1rem;
  }
  .none {
    color: var(--faint);
    font-size: 0.8rem;
  }
  .note {
    color: var(--muted);
    font-size: 0.9rem;
    max-width: 48rem;
  }
</style>
